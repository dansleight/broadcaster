{
  "ApplicationMode": "#{ApplicationMode}#",
  "EntraId": {
    "Instance": "https://login.microsoftonline.com/",
    "TenantId": "#tenantid#",
    "ClientId": "#clientid#",
    "WebApiScope": "#scope#"
  },
  "Database": {
    "Path": "/var/lib/broadcaster/broadcaster.db"
  },
  "ConnectionStrings": {
    "DefaultConnection": "#DefaultConnection#"
  },
  "RoleMappings": [
    {
      "Role": "Admin",
      "Groups": ["Admins"]
    }
  ],
  "Broadcast": {
    "RtmpUri": "rtmps://a.rtmps.youtube.com/live2"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "WriteTo": {
      "ConsoleSink": { "Name": "Console" },
      "EventLogSink": {
        "Name": "EventLog",
        "Args": {
          "source": "Broadcaster",
          "logName": "Broadcaster",
          "restrictedToMinimumLevel": "Error"
        }
      }
    },
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithEnvironmentName",
      "WithEnvironmentUserName",
      "WithClientIp",
      "WithCorrelationId",
      {
        "Name": "WithRequestHeader",
        "Args": {
          "headerName": "User-Agent"
        }
      },
      "WithExceptionDetails"
    ],
    "Properties": {
      "ApplicationMode": "#{ApplicationMode}",
      "ApplicationName": "Broadcaster"
    }
  },
  "AllowedHosts": "*"
}
