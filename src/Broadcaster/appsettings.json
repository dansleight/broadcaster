{
  "ApplicationMode": "#{ApplicationMode}#",
  "Google": {
    "ClientId": "#clientid#",
    "ClientSecret": "#clientsecret#",
    "RedirectUri": "#redirecturi#"
  },
  "Jwt": {
    "Issuer": "http://localhost:5034", // or "http://localhost:5034" in dev
    "Audience": "https://apercu.us", // usually same as Issuer for internal apps
    "SecurityKey": "wethepeopleoftheunitedstatesinordertoformamoreperfectunion",
    "AccessTokenLifetimeMinutes": 60 // Short-lived access token (recommended)
  },
  "Artifact": {
    // "Path": "/var/lib/broadcaster/"
  },
  "Database": {
    "FileName": "broadcaster.db"
  },
  "RoleMappings": [
    {
      "Role": "Admin",
      "Groups": ["Admins"]
    }
  ],
  "Broadcast": {
    "RtmpUri": "rtmps://a.rtmps.youtube.com/live2"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "WriteTo": {
      "ConsoleSink": { "Name": "Console" },
      "EventLogSink": {
        "Name": "EventLog",
        "Args": {
          "source": "Broadcaster",
          "logName": "Broadcaster",
          "restrictedToMinimumLevel": "Error"
        }
      }
    },
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithEnvironmentName",
      "WithEnvironmentUserName",
      "WithClientIp",
      "WithCorrelationId",
      {
        "Name": "WithRequestHeader",
        "Args": {
          "headerName": "User-Agent"
        }
      },
      "WithExceptionDetails"
    ],
    "Properties": {
      "ApplicationMode": "#{ApplicationMode}",
      "ApplicationName": "Broadcaster"
    }
  },
  "AllowedHosts": "*"
}
